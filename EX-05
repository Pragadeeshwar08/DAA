# Experiment 5 - Divide and Conquer Min-Max

def min_max(arr, low, high):

    # Only one element
    if low == high:
        return arr[low], arr[low]

    # Two elements
    if high == low + 1:
        if arr[low] < arr[high]:
            return arr[low], arr[high]
        else:
            return arr[high], arr[low]

    # Divide
    mid = (low + high) // 2

    left_min, left_max = min_max(arr, low, mid)
    right_min, right_max = min_max(arr, mid + 1, high)

    # Conquer
    minimum = left_min if left_min < right_min else right_min
    maximum = left_max if left_max > right_max else right_max

    return minimum, maximum


# -------- Driver Code --------

arr = [12, 45, 7, 89, 23, 56, 3, 90, 18]

minimum, maximum = min_max(arr, 0, len(arr) - 1)

print("Array :", arr)
print("Minimum element :", minimum)
print("Maximum element :", maximum)
