import heapq

# ---------- Kruskal Algorithm ----------

class DisjointSet:
    def __init__(self, n):
        self.parent = list(range(n))

    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]

    def union(self, x, y):
        px = self.find(x)
        py = self.find(y)

        if px != py:
            self.parent[py] = px
            return True
        return False


def kruskal(vertices, edges):
    edges.sort(key=lambda x: x[2])

    ds = DisjointSet(vertices)
    mst = []
    cost = 0

    for u, v, w in edges:
        if ds.union(u, v):
            mst.append((u, v, w))
            cost += w

    return mst, cost


# ---------- Prim Algorithm ----------

def prim(graph, start):
    visited = set()
    pq = [(0, start, -1)]
    mst = []
    cost = 0

    while pq:
        weight, node, parent = heapq.heappop(pq)

        if node in visited:
            continue

        visited.add(node)
        cost += weight

        if parent != -1:
            mst.append((parent, node, weight))

        for neighbor, wt in graph[node]:
            if neighbor not in visited:
                heapq.heappush(pq, (wt, neighbor, node))

    return mst, cost


# ---------- Driver Code ----------

vertices = 5

edges = [
    (0, 1, 2),
    (0, 3, 6),
    (1, 2, 3),
    (1, 3, 8),
    (1, 4, 5),
    (2, 4, 7),
    (3, 4, 9)
]

graph = {
    0: [(1,2),(3,6)],
    1: [(0,2),(2,3),(3,8),(4,5)],
    2: [(1,3),(4,7)],
    3: [(0,6),(1,8),(4,9)],
    4: [(1,5),(2,7),(3,9)]
}

mst1, cost1 = kruskal(vertices, edges)

print("Kruskal MST")
for u, v, w in mst1:
    print(u, "-", v, "=", w)
print("Total Cost =", cost1)

print()

mst2, cost2 = prim(graph, 0)

print("Prim MST")
for u, v, w in mst2:
    print(u, "-", v, "=", w)
print("Total Cost =", cost2)
