# Experiment 2 - String Matching Algorithms

def naive_search(text, pattern):
    pos = []
    for i in range(len(text) - len(pattern) + 1):
        if text[i:i+len(pattern)] == pattern:
            pos.append(i)
    return pos


def rabin_karp(text, pattern):
    n = len(text)
    m = len(pattern)

    p_hash = hash(pattern)

    pos = []

    for i in range(n - m + 1):
        if hash(text[i:i+m]) == p_hash:
            if text[i:i+m] == pattern:
                pos.append(i)

    return pos


def compute_lps(pattern):
    lps = [0] * len(pattern)
    length = 0
    i = 1

    while i < len(pattern):
        if pattern[i] == pattern[length]:
            length += 1
            lps[i] = length
            i += 1
        else:
            if length != 0:
                length = lps[length - 1]
            else:
                lps[i] = 0
                i += 1

    return lps


def kmp_search(text, pattern):
    lps = compute_lps(pattern)

    i = j = 0
    pos = []

    while i < len(text):
        if text[i] == pattern[j]:
            i += 1
            j += 1

        if j == len(pattern):
            pos.append(i - j)
            j = lps[j - 1]

        elif i < len(text) and text[i] != pattern[j]:
            if j != 0:
                j = lps[j - 1]
            else:
                i += 1

    return pos


# Driver Code
text = input("Enter Text: ")
pattern = input("Enter Pattern: ")

print("\nNaive Search:", naive_search(text, pattern))
print("Rabin-Karp:", rabin_karp(text, pattern))
print("KMP Search:", kmp_search(text, pattern))
